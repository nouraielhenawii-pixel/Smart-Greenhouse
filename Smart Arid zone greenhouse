#define BLYNK_TEMPLATE_ID "TMPL53PHQAnQI"
#define BLYNK_TEMPLATE_NAME "Smart Greenhouse"
#define BLYNK_AUTH_TOKEN "xxxxxxxxxxxxx"

#include <WiFi.h>
#include <BlynkSimpleEsp32.h>
#include <DHT.h>

// ---------------- WIFI ----------------
char ssid[] = "OPPO A78";
char pass[] = "xxxxxxxx";

// ---------------- PINS ----------------
#define DHTPIN 4
#define DHTTYPE DHT22

#define SOIL_PIN 34
#define LIGHT_PIN 35

#define FAN_PIN 26
#define PUMP_PIN 27
#define LED_PIN 25
#define BUTTON_PIN 14

// ---------------- OBJECTS ----------------
DHT dht(DHTPIN, DHTTYPE);
BlynkTimer timer;

// ---------------- PLANT SYSTEM ----------------
int plantMode = 0;
String plantName;

float tempMin, tempMax;
int soilMin, soilMax;
float lightMin, lightMax;

// ---------------- SOIL CALIBRATION ----------------
const int SOIL_DRY = 7;
const int SOIL_WET = 13;

// ---------------- READ SOIL (AVERAGING) ----------------
int readSoil()
{
  int sum = 0;

  for (int i = 0; i < 10; i++)
  {
    sum += analogRead(SOIL_PIN);
    delay(10);
  }

  return sum / 10;
}

// ---------------- SOIL % ----------------
int soilPercent(int raw)
{
  int percent = map(raw, SOIL_DRY, SOIL_WET, 0, 100);
  return constrain(percent, 0, 100);
}

// ---------------- LIGHT (RAW - SIMPLE USE) ----------------
int readLight()
{
  return analogRead(LIGHT_PIN);
}

// ---------------- DHT FIX ----------------
float correctTemp(float t)
{
  return t + 1.3;
}

// ---------------- PLANT PROFILES ----------------
void setPlantProfile()
{
  if (plantMode == 0)
  {
    plantName = "Rosemary";

    tempMin = 18; tempMax = 25;
    soilMin = 30; soilMax = 50;

    lightMin = 3900;
    lightMax = 4095;
  }
  else if (plantMode == 1)
  {
    plantName = "Cactus";

    tempMin = 20; tempMax = 35;
    soilMin = 10; soilMax = 30;

    lightMin = 3200;
    lightMax = 4095;
  }
  else
  {
    plantName = "Lavender";

    tempMin = 25; tempMax = 30;
    soilMin = 30; soilMax = 50;

    lightMin = 3600;
    lightMax = 4095;
  }

  Blynk.virtualWrite(V4, plantName);
}

// ---------------- SWITCH PLANT ----------------
BLYNK_WRITE(V3)
{
  plantMode = param.asInt();
  setPlantProfile();
}

// ---------------- SENSOR DATA ----------------
void sendSensorData()
{
  Serial.println("---- SENSOR UPDATE ----");

  // TEMP
  float temperature = correctTemp(dht.readTemperature());

  // SOIL
  int soilRaw = readSoil();
  int soil = soilPercent(soilRaw);

  // LIGHT (RAW ONLY FOR STABILITY)
  int light = readLight();

  Serial.print("Temp: "); Serial.println(temperature);
  Serial.print("Soil %: "); Serial.println(soil);
  Serial.print("Light raw: "); Serial.println(light);

  // SEND TO BLYNK
  Blynk.virtualWrite(V0, temperature);
  Blynk.virtualWrite(V1, soil);
  Blynk.virtualWrite(V2, light);

  // ---------------- CONTROL LOGIC ----------------

  // FAN (ACTIVE LOW RELAY FIX)
  if (temperature > tempMax)
    digitalWrite(FAN_PIN, LOW);   // ON
  else
    digitalWrite(FAN_PIN, HIGH);  // OFF

  // PUMP (ACTIVE LOW RELAY FIX)
  if (soil < soilMin)
    digitalWrite(PUMP_PIN, LOW);   // ON
  else
    digitalWrite(PUMP_PIN, HIGH);  // OFF

  // LED (simple threshold)
  if (light < 1500)
    digitalWrite(LED_PIN, LOW);   // ON
  else
    digitalWrite(LED_PIN, HIGH);  // OFF
}

// ---------------- BUTTON ----------------
void checkButton()
{
  if (digitalRead(BUTTON_PIN) == LOW)
  {
    plantMode = (plantMode + 1) % 3;
    setPlantProfile();
    delay(300);
  }
}

// ---------------- SETUP ----------------
void setup()
{
  Serial.begin(115200);
  delay(2000);

  pinMode(FAN_PIN, OUTPUT);
  pinMode(PUMP_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  // turn OFF all devices initially (IMPORTANT)
  digitalWrite(FAN_PIN, HIGH);
  digitalWrite(PUMP_PIN, HIGH);
  digitalWrite(LED_PIN, HIGH);

  dht.begin();

  WiFi.begin(ssid, pass);

  Serial.print("WiFi connecting");
  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi OK");

  Blynk.config(BLYNK_AUTH_TOKEN);

  setPlantProfile();

  timer.setInterval(5000L, sendSensorData);

  Serial.println("SYSTEM READY");
}

// ---------------- LOOP ----------------
void loop()
{
  if (!Blynk.connected())
    Blynk.connect();

  Blynk.run();
  timer.run();
  checkButton();
}
