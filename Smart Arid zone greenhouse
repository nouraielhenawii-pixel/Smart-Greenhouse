#define BLYNK_TEMPLATE_ID "TMPL53PHQAnQI"
#define BLYNK_TEMPLATE_NAME "Smart Greenhouse"
#define BLYNK_AUTH_TOKEN "xxxxxxxx"

#include <WiFi.h>
#include <BlynkSimpleEsp32.h>
#include <DHT.h>

// ---------------- WIFI ----------------
char ssid[] = "OPPO A78";
char pass[] = "99999999";

// ---------------- PINS ----------------
#define DHTPIN 4
#define DHTTYPE DHT22
#define SOIL_PIN 34
#define LIGHT_PIN 35

#define FAN_PIN 26
#define PUMP_PIN 27
#define LED_PIN 25
#define BUTTON_PIN 14

// ---------------- OBJECTS ----------------
DHT dht(DHTPIN, DHTTYPE);
BlynkTimer timer;

// ---------------- PLANT SYSTEM ----------------
int plantMode = 0;
String plantName;

float tempMin, tempMax;
int soilMin, soilMax;
int lightMin, lightMax;

// ---------------- PLANT PROFILES ----------------
void setPlantProfile()
{
  if (plantMode == 0)
  {
    plantName = "Rosemary";
    tempMin = 18; tempMax = 25;
    soilMin = 30; soilMax = 50;
    lightMin = 12000; lightMax = 20000;
  }
  else if (plantMode == 1)
  {
    plantName = "Cactus";
    tempMin = 20; tempMax = 35;
    soilMin = 10; soilMax = 30;
    lightMin = 8000; lightMax = 15000;
  }
  else
  {
    plantName = "Lavender";
    tempMin = 25; tempMax = 35;
    soilMin = 30; soilMax = 50;
    lightMin = 10000; lightMax = 15000;
  }

  Blynk.virtualWrite(V4, plantName);
}

// ---------------- BLYNK SWITCH ----------------
BLYNK_WRITE(V3)
{
  plantMode = param.asInt();
  setPlantProfile();
}

// ---------------- SENSOR FUNCTION ----------------
void sendSensorData()
{
  Serial.println("Reading sensors...");

  float temperature = dht.readTemperature();
  int soil = analogRead(SOIL_PIN);
  int light = analogRead(LIGHT_PIN);

  Serial.print("Temp: "); Serial.print(temperature);
  Serial.print(" | Soil: "); Serial.print(soil);
  Serial.print(" | Light: "); Serial.println(light);

  Blynk.virtualWrite(V0, temperature);
  Blynk.virtualWrite(V1, soil);
  Blynk.virtualWrite(V2, light);

  digitalWrite(FAN_PIN, (temperature > tempMax) ? HIGH : LOW);
  digitalWrite(PUMP_PIN, (soil < soilMin) ? HIGH : LOW);
  digitalWrite(LED_PIN, (light < lightMin) ? HIGH : LOW);
}

// ---------------- BUTTON ----------------
void checkButton()
{
  if (digitalRead(BUTTON_PIN) == LOW)
  {
    plantMode = (plantMode + 1) % 3;
    setPlantProfile();
    delay(300);
  }
}

// ---------------- SETUP (FIXED STABLE) ----------------
void setup()
{
  Serial.begin(115200);
  delay(2000);

  Serial.println("START");

  pinMode(FAN_PIN, OUTPUT);
  pinMode(PUMP_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  dht.begin();

  WiFi.begin(ssid, pass);

  Serial.print("WiFi connecting");
  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi OK");

  Blynk.config(BLYNK_AUTH_TOKEN);

  setPlantProfile();

  timer.setInterval(30000L, sendSensorData);

  Serial.println("Setup done");
}

// ---------------- LOOP (FIXED RECONNECT) ----------------
void loop()
{
  if (!Blynk.connected())
  {
    Serial.println("Reconnecting Blynk...");
    Blynk.connect();
  }

  Blynk.run();
  timer.run();
  checkButton();
}
